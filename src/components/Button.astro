---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'outline' | 'dark' | 'outline-light';
interface Props extends HTMLAttributes<'a'> {
  variant?: Variant;
  href: string;
  block?: boolean;
}
const { variant = 'primary', href, block = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, { 'btn--block': block }, className]} {...rest}>
  <span class="label-m"><slot /></span>
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: calc(20px + var(--optical)) 28px calc(20px - var(--optical));
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    background-size: 200% 100%;
    background-position: 0% 50%;
    transition:
      translate var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background-position var(--dur-base) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .btn--block { display: flex; width: 100%; }
  @media (max-width: 400px) {
    .btn { white-space: normal; text-align: center; }
  }

  .btn--primary {
    color: var(--on-brand);
    background-image: linear-gradient(90deg, var(--brand-green), var(--brand-blue), var(--brand-green));
  }
  .btn--dark {
    color: var(--on-brand);
    background-color: var(--bg);
  }
  .btn--outline {
    color: var(--text);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }
  .btn--outline-light {
    color: var(--on-brand);
    box-shadow: inset 0 0 0 1.5px var(--on-brand);
  }

  @media (hover: hover) {
    .btn:hover {
      translate: 0 -2px;
      box-shadow: 0 10px 24px rgb(0 0 0 / 0.3);
    }
    .btn--primary:hover { background-position: 100% 50%; }
    .btn--dark:hover { background-color: #000; }
    .btn--outline:hover { background-color: var(--text); color: var(--bg); box-shadow: 0 10px 24px rgb(0 0 0 / 0.3); }
    .btn--outline-light:hover { background-color: var(--on-brand); color: var(--brand-blue); box-shadow: 0 10px 24px rgb(0 0 0 / 0.3); }
  }
</style>
