---
import SectionLabel from './SectionLabel.astro';
import Button from './Button.astro';
import Tag from './Tag.astro';
import { getContent, asset } from '../i18n';

const { experience, ui, meta } = getContent(Astro.currentLocale);
const jobs = experience.jobs;
const total = String(jobs.length).padStart(2, '0');
const year = (s: string) => s.split(' ').pop() ?? s;
const span = (start: string, end: string, current?: boolean) => {
  const a = year(start);
  const b = current ? ui.present : year(end);
  return a === b ? a : `${a} – ${b}`;
};
const first = jobs[0];
const MOBILE_VISIBLE = 3;
---

<section class="sheet sheet--surface" id="experiencia" aria-labelledby="experiencia-title">
  <div class="sheet__content container xp">
    <aside class="xp__side">
      <SectionLabel number="02" title={experience.label} />
      <h2 class="h2" id="experiencia-title">{experience.title}</h2>
      <p class="body-l muted">{experience.intro}</p>
      <Button variant="outline" href={asset(meta.cvFile)} download={meta.cvDownloadName}>{ui.downloadCv}</Button>

      <div class="progress" aria-hidden="true">
        <div class="progress__head">
          <span class="label-s muted">{ui.progressLabel}</span>
          <span class="label-s accent"><span data-progress-n>01</span> / {total}</span>
        </div>
        <p class="h3 progress__now" data-progress-label>{span(first.start, first.end, first.current)} · {first.company}</p>
        <div class="progress__track"><span class="progress__fill" data-progress-fill></span></div>
      </div>
    </aside>

    <ol class="timeline" data-timeline>
      {jobs.map((job, i) => (
        <li
          class:list={['job', { 'job--current': job.current, 'job--extra': i >= MOBILE_VISIBLE }]}
          data-job
          data-label={`${span(job.start, job.end, job.current)} · ${job.company}`}
        >
          <p class:list={['label-s job__dates', job.current ? 'accent' : 'muted']}>
            {job.start} – {job.end}
          </p>
          <div class="job__rail" aria-hidden="true"><span class="job__dot"></span><span class="job__line"></span></div>
          <div class="job__body">
            <h3 class="h3">{job.company}</h3>
            <p class="job__role accent">{job.role}</p>
            {job.description && <p class="muted">{job.description}</p>}
            {job.tags && <ul class="job__tags">{job.tags.map((t) => <Tag label={t} />)}</ul>}
          </div>
        </li>
      ))}
    </ol>

    <button class="xp__more label-m" type="button" hidden aria-expanded="false">{ui.showFullCareer}</button>
  </div>
</section>

<style>
  .xp {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 96px;
    align-items: start;
  }
  .xp__side {
    position: sticky;
    top: var(--sticky-top);
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .progress {
    width: 100%;
    display: grid;
    gap: 12px;
    padding: 20px;
    margin-top: 8px;
    border-radius: var(--radius-md);
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .progress__head { display: flex; justify-content: space-between; }
  .progress__now { font-size: 18px; transition: opacity var(--dur-fast), translate var(--dur-fast); }
  .progress__now.is-changing { opacity: 0; translate: 0 8px; }
  .progress__track { height: 4px; border-radius: 4px; background: var(--border); overflow: hidden; }
  .progress__fill {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--brand-green), var(--brand-blue));
    transform-origin: left;
    transform: scaleX(var(--p, 0.125));
    transition: transform 120ms linear;
  }

  .timeline { display: grid; }
  .job {
    display: grid;
    grid-template-columns: 170px 24px minmax(0, 1fr);
    gap: 24px;
  }
  .job__dates { padding-top: 4px; }
  .job__rail { display: grid; grid-template-rows: 24px 1fr; justify-items: center; }
  .job__dot {
    align-self: center;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--muted);
  }
  .job--current .job__dot {
    width: 12px;
    height: 12px;
    border: 0;
    background: var(--brand-green);
  }
  .job__line { width: 2px; background: var(--border); }
  .job--current .job__line { background: linear-gradient(180deg, var(--brand-green), var(--brand-blue)); }
  .job:last-child .job__line { background: linear-gradient(180deg, var(--border), transparent); }
  .job__body { display: grid; gap: 6px; padding-bottom: 40px; }
  .job__tags { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 12px; }

  .xp__more {
    grid-column: 1 / -1;
    justify-self: stretch;
    padding: 16px;
    border-radius: 999px;
    border: 0;
    box-shadow: inset 0 0 0 1.5px var(--text);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .job--current .job__dot { animation: ripple 1.2s infinite; }
  }

  @media (max-width: 1023px) {
    .xp { grid-template-columns: 1fr; gap: 32px; }
    .xp__side { position: static; }
    .progress { display: none; }
    .job { grid-template-columns: 24px minmax(0, 1fr); column-gap: 16px; }
    .job__dates { grid-column: 1 / -1; padding: 0 0 6px; }
    .job__body { padding-bottom: 28px; }
    :global(.js) .timeline:not(.is-expanded) .job--extra { display: none; }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const jobs = Array.from(document.querySelectorAll<HTMLElement>('[data-job]'));
  const n = document.querySelector<HTMLElement>('[data-progress-n]');
  const label = document.querySelector<HTMLElement>('[data-progress-label]');
  const fill = document.querySelector<HTMLElement>('[data-progress-fill]');
  const more = document.querySelector<HTMLButtonElement>('.xp__more');

  // "Ver trayectoria completa" solo en mobile/tablet
  const mq = window.matchMedia('(max-width: 1023px)');
  if (more && timeline) {
    const sync = () => (more.hidden = !mq.matches || timeline.classList.contains('is-expanded'));
    sync();
    mq.addEventListener('change', sync);
    more.addEventListener('click', () => {
      timeline.classList.add('is-expanded');
      more.setAttribute('aria-expanded', 'true');
      more.hidden = true;
      jobs[3]?.querySelector('h3')?.setAttribute('tabindex', '-1');
      (jobs[3]?.querySelector('h3') as HTMLElement | null)?.focus();
    });
  }

  // Progreso "Recorriendo": ítem activo = el más cercano a la línea de lectura
  if (timeline && n && label && fill) {
    let current = 0;
    let raf = 0;
    const update = () => {
      raf = 0;
      const line = window.innerHeight * 0.45;
      let idx = 0;
      jobs.forEach((j, i) => {
        if (j.getBoundingClientRect().top <= line) idx = i;
      });
      const r = timeline.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
      fill.style.setProperty('--p', String(Math.max(p, (idx + 1) / jobs.length * 0.999)));
      if (idx !== current) {
        current = idx;
        label.classList.add('is-changing');
        window.setTimeout(() => {
          n.textContent = String(idx + 1).padStart(2, '0');
          label.textContent = jobs[idx].dataset.label ?? '';
          label.classList.remove('is-changing');
        }, 150);
      }
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
