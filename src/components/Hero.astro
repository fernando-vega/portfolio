---
import { Picture } from 'astro:assets';
import photo from '../assets/foto-fernando.png';
import Nav from './Nav.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getContent, asset } from '../i18n';

const t = getContent(Astro.currentLocale);
const { profile, heroChips, ui, meta } = t;
---

<header class="hero" id="inicio">
  <canvas class="hero__particles" aria-hidden="true"></canvas>
  <div class="hero__shade" aria-hidden="true"></div>
  <Nav />

  <div class="hero__inner container">
    <div class="hero__intro">
      <p class="label-m">{ui.greeting}</p>
      <h1 class="display-l hero__title">{profile.headline}</h1>
      <ol class="lifecycle" aria-label={ui.lifecycleLabel}>
        {profile.lifecycle.map((s) => <li class="lifecycle__step label-s" data-step>{s}</li>)}
        <li class="lifecycle__ai label-s" title={profile.aiTagLabel}>
          <Icon name="ai" size={13} />{profile.aiTag}<span class="sr-only">: {profile.aiTagLabel}</span>
        </li>
      </ol>
      <p class="h3 hero__role">{profile.role}<br />{profile.org}</p>
      <p class="body-l hero__text">
        <span class="hero__text--long">{profile.intro}</span>
        <span class="hero__text--short">{profile.introShort}</span>
      </p>
      <div class="hero__ctas">
        <Button variant="dark" href="#contacto">{ui.ctaTalk}</Button>
        <Button variant="outline-light" href="#proyectos">{ui.ctaProjects}</Button>
      </div>
      <a class="label-s hero__cv" href={asset(meta.cvFile)} download={meta.cvDownloadName}>{ui.downloadCv} <Icon name="download" size={14} /></a>
    </div>

    <div class="photo" data-tilt>
      <div class="photo__glow" aria-hidden="true"></div>
      <div class="photo__card">
        <Picture
          src={photo}
          alt={meta.portraitAlt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={72}
          widths={[360, 480, 720, 960]}
          sizes="(max-width: 1023px) calc(100vw - 40px), 480px"
          loading="eager"
          fetchpriority="high"
          class="photo__img"
        />
      </div>
      <p class="chip chip--a label-s">{heroChips.stats}</p>
      <p class="chip chip--b label-s"><span class="dot-live"></span>{heroChips.availability}</p>
    </div>
  </div>

  <a class="scroll-cue" href="#sobre-mi" aria-label={ui.scrollCue}>
    <span class="scroll-cue__label label-m" aria-hidden="true">{ui.scrollCue}</span>
    <span class="scroll-cue__track" aria-hidden="true"><span class="scroll-cue__dot"></span></span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 760px);
    padding-bottom: calc(var(--sheet-radius) + 48px);
    color: var(--on-brand);
    background: var(--brand-gradient);
    overflow: clip;
  }
  .hero__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(11 13 16 / 0) 0%, rgb(11 13 16 / 0.55) 100%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 720px) minmax(0, 480px);
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    padding-top: clamp(48px, 8vh, 96px);
    padding-right: calc(var(--gutter) + 40px);
  }
  .hero__intro { display: grid; gap: 24px; justify-items: start; }
  .hero__title { max-width: 640px; }
  .hero__role { max-width: 620px; }
  .hero__text { max-width: 620px; opacity: 0.9; }
  .hero__text--short { display: none; }
  .hero__ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .hero__cv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--on-brand);
    text-underline-offset: 4px;
  }

  /* ciclo de vida */
  .lifecycle { display: flex; flex-wrap: wrap; gap: 6px; }
  .lifecycle__step {
    padding: 7px 11px;
    border-radius: 999px;
    background: rgb(11 13 16 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.28);
    cursor: default;
    transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), border-color var(--dur-base);
  }
  .lifecycle__ai {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    color: var(--on-brand);
    background: rgb(11 13 16 / 0.45);
    border: 1px solid var(--brand-green);
    box-shadow: 0 0 14px rgb(68 206 162 / 0.35);
  }
  .lifecycle__ai :global(svg) { color: var(--brand-green); }
  @media (prefers-reduced-motion: no-preference) {
    .lifecycle__ai { animation: ai-glow 3s ease-in-out infinite; }
  }
  @keyframes ai-glow {
    0%, 100% { box-shadow: 0 0 6px rgb(68 206 162 / 0.25); }
    50% { box-shadow: 0 0 20px rgb(68 206 162 / 0.6); }
  }
  .lifecycle__step.is-active {
    background: #fff;
    color: var(--brand-blue);
    border-color: #fff;
  }

  /* tarjeta de la foto */
  .photo {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    width: 100%;
    max-width: 480px;
    justify-self: end;
    perspective: 900px;
  }
  .photo__glow {
    position: absolute;
    left: 12%;
    top: 22%;
    width: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(68 206 162 / 0.55);
    filter: blur(120px);
    pointer-events: none;
  }
  .photo__card {
    position: relative;
    aspect-ratio: 480 / 560;
    border-radius: var(--radius-lg);
    padding: 2px;
    background: var(--brand-gradient);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.35);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 400ms var(--ease-out);
    overflow: hidden;
  }
  .photo__card :global(picture),
  .photo__card :global(img) {
    width: 100%;
    height: 100%;
  }
  .photo__card :global(img) {
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 2px);
  }

  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 999px;
    background: rgb(11 13 16 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.16);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.35);
    white-space: nowrap;
  }
  .chip--a { left: -56px; top: 28px; }
  .chip--b { right: -40px; bottom: 36px; }

  /* señal de scroll (borde derecho) */
  .scroll-cue {
    position: absolute;
    right: calc(var(--gutter) / 2 + 8px);
    bottom: calc(var(--sheet-radius) + 40px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: var(--on-brand);
    text-decoration: none;
  }
  .scroll-cue__label {
    writing-mode: vertical-rl;
    font-size: 16px;
    background: repeating-linear-gradient(-45deg, #fff 0 5px, rgb(255 255 255 / 0.55) 5px 10px);
    background-size: 14px 14px;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .scroll-cue__track {
    position: relative;
    width: 1.5px;
    height: 96px;
    background: rgb(255 255 255 / 0.3);
  }
  .scroll-cue__dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 6px rgb(255 255 255 / 0.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo__card { animation: photo-in 900ms var(--ease-out) both; }
    .chip { animation: chip-in 500ms var(--ease-out) 600ms both, float 4s ease-in-out 1.1s infinite; }
    .chip--b { animation-delay: 750ms, 2.3s; }
    .photo__glow { animation: glow 6s ease-in-out infinite; }
    .scroll-cue__label { animation: stripes 1.8s linear infinite; }
    .scroll-cue__dot { animation: cue 1.6s ease-in-out infinite; }

    @supports (animation-timeline: scroll()) {
      .photo {
        animation: parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .photo__card :global(img) {
        animation: zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .scroll-cue {
        animation: fade-out linear both;
        animation-timeline: scroll(root);
        animation-range: 0 120px;
      }
    }
  }

  @keyframes photo-in {
    from { clip-path: inset(100% 0 0 0 round var(--radius-lg)); scale: 1.06; }
    to { clip-path: inset(0 0 0 0 round var(--radius-lg)); scale: 1; }
  }
  @keyframes chip-in { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes glow { 0%, 100% { opacity: 0.8; scale: 1; } 50% { opacity: 1; scale: 1.08; } }
  @keyframes stripes { to { background-position: 14px 0; } }
  @keyframes cue { 0% { top: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  @keyframes parallax { to { translate: 0 -60px; } }
  @keyframes zoom { to { scale: 1.08; } }
  @keyframes fade-out { to { opacity: 0; visibility: hidden; } }

  /* ---------- tablet / mobile ---------- */
  @media (max-width: 1023px) {
    .hero { min-height: auto; padding-bottom: calc(var(--sheet-radius) + 56px); }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 24px;
      padding-right: var(--gutter);
    }
    .photo { order: -1; max-width: 560px; justify-self: stretch; perspective: none; }
    .photo__card { aspect-ratio: 350 / 380; }
    .photo__card::after {
      content: '';
      position: absolute;
      inset: auto 2px 2px 2px;
      height: 42%;
      border-radius: 0 0 calc(var(--radius-lg) - 2px) calc(var(--radius-lg) - 2px);
      background: linear-gradient(180deg, rgb(11 13 16 / 0), rgb(11 13 16 / 0.85));
    }
    .photo__glow { display: none; }
    .chip { padding: 8px 12px; gap: 8px; }
    .chip--a { left: 16px; top: auto; bottom: 60px; }
    .chip--b { left: 16px; right: auto; bottom: 16px; }
    .hero__ctas { display: grid; width: 100%; }
    .scroll-cue { display: none; }
  }
  @media (max-width: 599px) {
    .hero__title { font-size: 40px; }
    .hero__role { font-size: 20px; }
    .hero__text--long { display: none; }
    .hero__text--short { display: inline; }
    .lifecycle__step { font-size: 11px; padding: 6px 10px; }
  }
</style>

<script>
  import { initParticles } from '../scripts/particles';
  import { initLifecycle, initTilt } from '../scripts/hero';

  const canvas = document.querySelector<HTMLCanvasElement>('.hero__particles');
  if (canvas) initParticles(canvas);
  const life = document.querySelector<HTMLElement>('.lifecycle');
  if (life) initLifecycle(life);
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (tilt) initTilt(tilt);
</script>
