---
import { Picture } from 'astro:assets';
import photo from '../assets/foto-fernando.png';
import Nav from './Nav.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getContent, asset } from '../i18n';

const t = getContent(Astro.currentLocale);
const { profile, heroChips, ui, meta } = t;

// La última palabra del rol + " · Full Stack" viajan juntas (CSS nowrap),
// así el separador "·" nunca queda al inicio de una línea.
const roleWords = profile.role.split(' ');
const roleLast = roleWords.pop();
const roleHead = roleWords.join(' ');
---

<Nav />
<header class="hero" id="inicio">
  <canvas class="hero__particles" aria-hidden="true"></canvas>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner container">
    <div class="hero__intro">
      <p class="label-m">{ui.greeting}</p>
      <h1 class="display-l hero__title">{profile.headline}</h1>
      <p class="h3 hero__role">
        {roleHead}{' '}<span class="nowrap">{roleLast} · {profile.roleTag}</span><br />{profile.org}
      </p>
      <p class="body-l hero__text">
        <span class="hero__text--long">{profile.intro}</span>
        <span class="hero__text--short">{profile.introShort}</span>
      </p>
      <div class="hero__ctas">
        <Button variant="dark" href="#contacto">{ui.ctaTalk}</Button>
        <Button variant="outline-light" href="#proyectos">{ui.ctaProjects}</Button>
        <a class="label-s hero__cv" href={asset(meta.cvFile)} download={meta.cvDownloadName}>{ui.downloadCv} <Icon name="download" size={16} /></a>
      </div>
    </div>

    <div class="photo" data-tilt>
      <div class="photo__glow" aria-hidden="true"></div>
      <div class="photo__card">
        <Picture
          src={photo}
          alt={meta.portraitAlt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={72}
          widths={[360, 480, 720, 960]}
          sizes="(max-width: 1023px) calc(100vw - 40px), 440px"
          loading="eager"
          fetchpriority="high"
          class="photo__img"
        />
      </div>
      <p class="chip chip--a label-s">{heroChips.stats}</p>
    </div>
  </div>

  <div class="hero__band container">
    <p class="label-s hero__band-label" aria-hidden="true">{ui.lifecycleLabel}</p>
    <ol class="lifecycle" aria-label={ui.lifecycleLabel}>
      {profile.lifecycle.map((s) => <li class="lifecycle__step label-s" data-step>{s}</li>)}
      <li class="lifecycle__ai label-s" title={profile.aiTagLabel}>
        <Icon name="ai" size={16} />{profile.aiTag}<span class="sr-only">: {profile.aiTagLabel}</span>
      </li>
    </ol>
  </div>

  <a class="scroll-cue" href="#sobre-mi" aria-label={ui.scrollCue}>
    <span class="scroll-cue__label label-m" aria-hidden="true">{ui.scrollCue}</span>
    <span class="scroll-cue__track" aria-hidden="true"><span class="scroll-cue__dot"></span></span>
  </a>
</header>

<style>
  .hero {
    /* position: sticky viene de global.css (tarjetas apiladas) */
    min-height: max(100svh, 720px);
    display: flex;
    flex-direction: column;
    padding-top: 112px; /* espacio para el menú */
    padding-bottom: calc(var(--sheet-radius) + 32px);
    color: var(--on-brand);
    background: var(--brand-gradient);
    overflow: clip;
  }
  .hero__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(11 13 16 / 0) 0%, rgb(11 13 16 / 0.55) 100%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(40px, 6vw, 112px);
    padding-block: 16px 24px;
    padding-right: calc(var(--gutter) + 56px); /* deja libre la señal de scroll */
  }
  .hero__intro { display: grid; gap: 28px; justify-items: start; max-width: 660px; }
  .hero__title { font-size: clamp(40px, 4.3vw, 64px); max-width: 620px; }
  .hero__role { max-width: 620px; }
  .hero__role .nowrap { white-space: nowrap; }
  .hero__text { max-width: 600px; opacity: 0.9; }
  .hero__text--short { display: none; }
  .hero__ctas { display: flex; align-items: center; gap: 16px 20px; flex-wrap: wrap; padding-top: 4px; }
  .hero__cv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 4px;
    color: var(--on-brand);
    text-underline-offset: 6px;
  }

  /* franja inferior: etapas del ciclo de vida */
  .hero__band {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 32px;
    padding-top: 24px;
    padding-right: calc(var(--gutter) + 56px);
  }
  .hero__band::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: calc(var(--gutter) + 56px);
    height: 1px;
    background: rgb(255 255 255 / 0.22);
  }
  .hero__band-label { opacity: 0.8; }

  /* ciclo de vida */
  .lifecycle { display: flex; flex-wrap: wrap; gap: 6px; }
  .lifecycle__step {
    padding: calc(10px + var(--optical)) 12px calc(10px - var(--optical));
    border-radius: 999px;
    background: rgb(11 13 16 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.28);
    cursor: default;
    transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), border-color var(--dur-base);
  }
  .lifecycle__ai {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: calc(10px + var(--optical)) 12px calc(10px - var(--optical));
    border-radius: 999px;
    color: #fff;
    background: rgb(11 13 16 / 0.82);
    border: 1px solid #fff;
    box-shadow: 0 0 10px rgb(255 255 255 / 0.35);
  }
  .lifecycle__ai :global(svg) { color: var(--brand-green); }
  @media (prefers-reduced-motion: no-preference) {
    .lifecycle__ai { animation: ai-glow 2.4s ease-in-out infinite; }
  }
  /* resplandor blanco: contrasta con el degradado verde-azul del hero */
  @keyframes ai-glow {
    0%, 100% { box-shadow: 0 0 4px rgb(255 255 255 / 0.25), 0 0 0 0 rgb(255 255 255 / 0); }
    50% { box-shadow: 0 0 18px rgb(255 255 255 / 0.85), 0 0 0 4px rgb(255 255 255 / 0.18); }
  }
  .lifecycle__step.is-active {
    background: #fff;
    color: var(--brand-blue);
    border-color: #fff;
  }

  /* tarjeta de la foto */
  .photo {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    width: clamp(300px, calc((100svh - 360px) * 0.857), 440px);
    justify-self: end;
    perspective: 900px;
  }
  .photo__glow {
    position: absolute;
    left: 12%;
    top: 22%;
    width: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(68 206 162 / 0.55);
    filter: blur(120px);
    pointer-events: none;
  }
  .photo__card {
    position: relative;
    aspect-ratio: 480 / 560;
    border-radius: var(--radius-lg);
    padding: 2px;
    background: var(--brand-gradient);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.35);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 400ms var(--ease-out);
    overflow: hidden;
  }
  .photo__card :global(picture),
  .photo__card :global(img) {
    width: 100%;
    height: 100%;
  }
  .photo__card :global(img) {
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 2px);
  }

  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: calc(12px + var(--optical)) 16px calc(12px - var(--optical));
    border-radius: 999px;
    background: rgb(11 13 16 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.16);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.35);
    white-space: nowrap;
  }
  .chip--a { left: -56px; top: 28px; }

  /* señal de scroll (borde derecho) */
  .scroll-cue {
    position: absolute;
    right: calc(var(--gutter) / 2 + 8px);
    bottom: calc(var(--sheet-radius) + 40px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: var(--on-brand);
    text-decoration: none;
  }
  .scroll-cue__label {
    writing-mode: vertical-rl;
    font-size: 16px;
    background: repeating-linear-gradient(-45deg, #fff 0 5px, rgb(255 255 255 / 0.55) 5px 10px);
    background-size: 14px 14px;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .scroll-cue__track {
    position: relative;
    width: 1.5px;
    height: 96px;
    background: rgb(255 255 255 / 0.3);
  }
  .scroll-cue__dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 6px rgb(255 255 255 / 0.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo__card { animation: photo-in 900ms var(--ease-out) both; }
    .chip { animation: chip-in 500ms var(--ease-out) 600ms both, float 4s ease-in-out 1.1s infinite; }
    .photo__glow { animation: glow 6s ease-in-out infinite; }
    .scroll-cue__label { animation: stripes 1.8s linear infinite; }
    .scroll-cue__dot { animation: cue 1.6s ease-in-out infinite; }

    @supports (animation-timeline: scroll()) {
      .photo {
        animation: parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .photo__card :global(img) {
        animation: zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .scroll-cue {
        animation: fade-out linear both;
        animation-timeline: scroll(root);
        animation-range: 0 120px;
      }
    }
  }

  @keyframes photo-in {
    from { clip-path: inset(100% 0 0 0 round var(--radius-lg)); scale: 1.06; }
    to { clip-path: inset(0 0 0 0 round var(--radius-lg)); scale: 1; }
  }
  @keyframes chip-in { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes glow { 0%, 100% { opacity: 0.8; scale: 1; } 50% { opacity: 1; scale: 1.08; } }
  @keyframes stripes { to { background-position: 14px 0; } }
  @keyframes cue { 0% { top: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  @keyframes parallax { to { translate: 0 -60px; } }
  @keyframes zoom { to { scale: 1.08; } }
  @keyframes fade-out { to { opacity: 0; visibility: hidden; } }

  /* pantallas bajas (laptops 720–820 px de alto): todo el hero entra sin scroll */
  @media (min-width: 1024px) and (max-height: 820px) {
    .hero { padding-top: 92px; padding-bottom: calc(var(--sheet-radius) + 20px); }
    .hero__inner { padding-block: 0 8px; }
    .hero__intro { gap: 18px; }
    .hero__title { font-size: clamp(40px, 3.8vw, 54px); }
    .hero__band { margin-top: 16px; padding-top: 16px; }
    .photo { width: clamp(280px, calc((100svh - 300px) * 0.857), 400px); }
  }

  /* ---------- tablet / mobile ---------- */
  @media (max-width: 1023px) {
    .hero { min-height: auto; padding-top: 88px; padding-bottom: calc(var(--sheet-radius) + 40px); }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 8px 0;
      padding-right: var(--gutter);
    }
    .photo { order: -1; width: 100%; max-width: 560px; justify-self: stretch; perspective: none; }
    .photo__card { aspect-ratio: 350 / 380; }
    .photo__card::after {
      content: '';
      position: absolute;
      inset: auto 2px 2px 2px;
      height: 42%;
      border-radius: 0 0 calc(var(--radius-lg) - 2px) calc(var(--radius-lg) - 2px);
      background: linear-gradient(180deg, rgb(11 13 16 / 0), rgb(11 13 16 / 0.85));
    }
    .photo__glow { display: none; }
    .chip { padding: calc(8px + var(--optical)) 12px calc(8px - var(--optical)); gap: 8px; max-width: calc(100% - 32px); white-space: normal; }
    .chip--a { left: 16px; top: auto; bottom: 16px; }
    .hero__intro { gap: 24px; }
    .hero__ctas { display: grid; width: 100%; }
    .hero__cv { margin: 4px 0 0; }
    .hero__band { padding-right: var(--gutter); margin-top: 40px; }
    .hero__band::before { right: var(--gutter); }
    .scroll-cue { display: none; }
  }
  @media (max-width: 599px) {
    .hero__title { font-size: 40px; }
    .hero__role { font-size: 20px; }
    .hero__text--long { display: none; }
    .hero__text--short { display: inline; }
    .lifecycle__step, .lifecycle__ai { padding: calc(8px + var(--optical)) 10px calc(8px - var(--optical)); }
  }
</style>

<script>
  import { initParticles } from '../scripts/particles';
  import { initLifecycle, initTilt } from '../scripts/hero';

  const canvas = document.querySelector<HTMLCanvasElement>('.hero__particles');
  if (canvas) initParticles(canvas);
  const life = document.querySelector<HTMLElement>('.lifecycle');
  if (life) initLifecycle(life);
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (tilt) initTilt(tilt);
</script>
