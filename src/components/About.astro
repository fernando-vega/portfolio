---
import SectionLabel from './SectionLabel.astro';
import { getContent } from '../i18n';

const { about } = getContent(Astro.currentLocale);
---

<section class="sheet" id="sobre-mi" aria-labelledby="sobre-mi-title">
  <div class="sheet__content container about">
    <div class="about__head">
      <SectionLabel number="01" title={about.label} />
    </div>
    <div class="about__row">
      <div class="about__sticky">
        <h2 class="h2" id="sobre-mi-title" data-reveal>{about.title}</h2>
        <p class="label-s muted" data-reveal>{about.meta}</p>
      </div>
      <div class="about__body">
        {about.paragraphs.map((p) => <p class="body-l muted" data-reveal>{p}</p>)}
        <ul class="stats">
          {about.stats.map((s) => (
            <li class="stat" data-reveal>
              <span class="h2 accent stat__v">{s.value}</span>
              <span class="body-s muted stat__l">{s.label}</span>
              <span class="label-s muted stat__s">{s.short}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about { display: grid; gap: 48px; }
  .about__row {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
    gap: 96px;
    align-items: start;
  }
  .about__sticky {
    position: sticky;
    top: var(--sticky-top);
    display: grid;
    gap: 20px;
  }
  .about__body { display: grid; gap: 24px; }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 16px;
  }
  .stat {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .stat__v { font-size: 44px; }
  .stat__s { display: none; }

  @media (max-width: 1023px) {
    .about__row { grid-template-columns: 1fr; gap: 24px; }
    .about__sticky { position: static; }
  }
  @media (max-width: 599px) {
    .about { gap: 24px; }
    .stats { gap: 12px; }
    .stat { padding: 16px; }
    .stat__v { font-size: 28px; }
    .stat__l { display: none; }
    .stat__s { display: block; }
  }
  @media (max-width: 419px) {
    .stats { grid-template-columns: 1fr; gap: 8px; }
    .stat { grid-template-columns: auto 1fr; align-items: baseline; gap: 12px; padding: 14px 16px; }
  }
</style>
