---
import SectionLabel from './SectionLabel.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getContent } from '../i18n';

const { advisory, contact, ui } = getContent(Astro.currentLocale);
---

<section class="sheet sheet--surface" id="asesoria" aria-labelledby="asesoria-title">
  <div class="sheet__content container adv">
    <header class="adv__head">
      <div class="adv__title">
        <SectionLabel number="04" title={advisory.label} />
        <h2 class="h2" id="asesoria-title" data-reveal>{advisory.title}</h2>
      </div>
      <p class="body-l muted" data-reveal>{advisory.intro}</p>
    </header>

    <ul class="services">
      {advisory.services.map((s, i) => (
        <li class="service" data-card style={`--i: ${i}`}>
          <span class="service__glow" aria-hidden="true"></span>
          <span class="service__icon"><Icon name={s.icon} size={28} /></span>
          <h3 class="h3">{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ul>

    <div class="how" data-reveal>
      <p class="label-m accent">{ui.howIWork}</p>
      <ol class="how__steps">
        {advisory.steps.map((s, i) => (
          <li><span class="how__n label-s">{i + 1}</span><span class="body-s">{s}</span></li>
        ))}
      </ol>
      <Button href={contact.advisoryMailto}>{ui.bookCall}</Button>
    </div>
  </div>
</section>

<style>
  .adv { display: grid; gap: 48px; }
  .adv__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: 96px;
    align-items: end;
  }
  .adv__title { display: grid; gap: 24px; }
  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .services { perspective: 900px; }
  .service {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 32px;
    border-radius: 20px;
    background: var(--bg);
    border: 1px solid var(--border);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 400ms var(--ease-out), border-color var(--dur-base), box-shadow var(--dur-base);
  }
  /* luz que sigue al cursor (como el resplandor de la foto) */
  .service__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgb(68 206 162 / 0.22), transparent 70%);
    opacity: 0;
    transition: opacity var(--dur-base);
    pointer-events: none;
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgb(68 206 162 / 0.12);
    color: var(--accent);
    transition: box-shadow var(--dur-base), translate var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .service:hover {
      border-color: rgb(68 206 162 / 0.55);
      box-shadow: 0 24px 48px rgb(0 0 0 / 0.35);
    }
    .service:hover .service__glow { opacity: 1; }
    .service:hover .service__icon { box-shadow: 0 0 22px rgb(68 206 162 / 0.45); translate: 0 -2px; }
  }

  /* entrada: se descubre de abajo hacia arriba con leve zoom, escalonada */
  @keyframes card-in {
    from { clip-path: inset(100% 0 0 0 round 20px); scale: 1.04; }
    to { clip-path: inset(0 0 0 0 round 20px); scale: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .service {
        animation: card-in linear both;
        animation-timeline: view();
        animation-range: entry calc(5% + var(--i) * 12%) entry calc(60% + var(--i) * 12%);
      }
    }
    @supports not (animation-timeline: view()) {
      :global(.js) .service {
        clip-path: inset(100% 0 0 0 round 20px);
        scale: 1.04;
        transition: clip-path 900ms var(--ease-out), scale 900ms var(--ease-out), transform 400ms var(--ease-out);
        transition-delay: calc(var(--i) * 120ms);
      }
      :global(.js) .service.is-in { clip-path: inset(0 0 0 0 round 20px); scale: 1; }
    }
  }
  .how {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: 28px 32px;
    border-radius: 20px;
    background: var(--bg);
  }
  .how__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .how__steps li { display: flex; align-items: center; gap: 12px; }
  .how__n {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    padding-top: calc(2 * var(--optical));
    line-height: 1;
    border-radius: 50%;
    background: var(--brand-gradient);
    color: var(--on-brand);
  }

  @media (max-width: 1023px) {
    .adv__head { grid-template-columns: 1fr; gap: 24px; }
    .services { grid-template-columns: 1fr; }
    .how { grid-template-columns: 1fr; gap: 20px; }
    .how__steps { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-width: 599px) {
    .adv { gap: 24px; }
    .service { padding: 24px; }
    .how { padding: 24px; }
  }
</style>

<script>
  import { initTilt } from '../scripts/hero';

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
    initTilt(card);
    if (!fine || reduce) return;
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
