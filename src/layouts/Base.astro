---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo-black/latin-400.css';
import '@fontsource/overpass-mono/latin-400.css';
import '@fontsource/overpass-mono/latin-500.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import photo from '../assets/foto-fernando.png';
import { profile, experience, stack } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}
const { title = profile.seo.title, description = profile.seo.description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(base, Astro.site).href;
const og = await getImage({ src: photo, width: 1200, height: 630, format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;

const current = experience.jobs.find((j) => j.current);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: canonical,
  image: ogUrl,
  email: `mailto:${profile.email}`,
  jobTitle: 'Ingeniero de Sistemas · Desarrollador Full Stack',
  worksFor: current ? { '@type': 'Organization', name: current.company } : undefined,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Pedagógica y Tecnológica de Colombia (UPTC)' },
  address: { '@type': 'PostalAddress', addressCountry: 'CO' },
  sameAs: [profile.social.linkedin, profile.social.github, 'https://tramafin.com/autor'],
  knowsAbout: stack.groups.flatMap((g) => g.items),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0B0D10" />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Retrato de ${profile.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import '../scripts/fallback-observer';
    </script>
  </body>
</html>
